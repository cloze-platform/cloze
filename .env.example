# Cloze environment configuration
# Copy this file to .env for local development. Every setting the app reads is
# listed here; llm_chat/config.py is the source of truth for defaults.
# In production (FLASK_ENV=production) the app refuses to start if a required
# setting is missing.

# --- Core ---------------------------------------------------------------------

# "production" turns on secure cookies, HSTS and the startup checks.
# FLASK_ENV=production

# Required in production. Signs login sessions; changing it logs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Required in production (PostgreSQL). Defaults to a local SQLite file.
# DATABASE_URL=sqlite:///llm_chat.db

# Deployments only: the restricted database user the app connects as. Set it
# when running `python manage.py init-production` as the owner, which creates it.
# CLOZE_APP_DATABASE_URL=

# Public base URL of this instance, used for links in outgoing email.
# Required in production when CLOZE_GUARD_SENDER is set.
# CLOZE_PUBLIC_URL=http://localhost:5051

# Report generation (NLP analysis and AI summaries of transcripts). Set to false
# to turn it off for the whole instance, whatever admins or providers choose.
# CLOZE_REPORTS_ENABLED=true

# Instance colours: a JSON object overriding any of primary, hover, accent, tint,
# on_dark, on_dark_hover, dark_page, dark_sidebar, dark_card, dark_raised and
# dark_border (#RRGGBB). Anything not given keeps the Cloze palette.
# CLOZE_THEME={"primary": "#1C488F", "hover": "#223D71"}

# --- LLM providers (set at least one) ------------------------------------------

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ollama server for local models (defaults to localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# --- CLOZE-Guard alert email (AWS SES, optional) ---------------------------------

# From address on a verified SES identity. Leave unset to disable alert emails.
# CLOZE_GUARD_SENDER=noreply@cloze.example.org
# AWS_SES_REGION=us-east-1

# Local development only: AWS CLI profile used to send through SES.
# In production, leave unset; the server's IAM role is used.
# CLOZE_GUARD_AWS_PROFILE=
